<?xml version="1.0" encoding="utf-8"?>
<!-- Inactive record button: blue ring + dark gap + gray inner dot -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_ring" />
        </shape>
    </item>
    <item
        android:top="5dp"
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_gap" />
        </shape>
    </item>
    <item
        android:top="12dp"
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="oval">
            <solid android:color="@color/rec_inactive" />
        </shape>
    </item>
</layer-list>
