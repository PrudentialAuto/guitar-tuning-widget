<?xml version="1.0" encoding="utf-8"?>
<!-- Simple microphone launcher icon using only <path> elements -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Mic body: rounded rectangle 44,28 → 64,68 with r=10 corners
      Using M/L/A path commands only.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M54,22
          A12,12,0,0,0,42,34
          L42,60
          A12,12,0,0,0,66,60
          L66,34
          A12,12,0,0,0,54,22
          Z" />
    <!-- Mic stand: arc + pole + base -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M36,56
          A18,18,0,0,0,72,56
          L68,56
          A14,14,0,0,1,40,56
          Z" />
    <!-- Pole -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52,74 L56,74 L56,86 L52,86 Z" />
    <!-- Base -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,86 L64,86 L64,90 L44,90 Z" />
</vector>
